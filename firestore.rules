rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // For this app, only the owner (the user) should manage content.
      // We can check against a list of authorized emails or just allow the first user for now,
      // but a better way is to check if the user is signed in with a specific verified email.
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Property Validation
    function isValidProperty(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.type is string && data.type.size() <= 100 &&
             data.location is string && data.location.size() <= 100 &&
             data.category in ['edificios', 'hoteles', 'industrial', 'solar', 'local', 'oficinas', 'singulares'] &&
             data.image is string &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    match /properties/{propertyId} {
      allow read, write: if true; // Public listings and direct administrative access
    }
  }
}
